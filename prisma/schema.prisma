generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model PhotoSession {
  id          String   @id @default(uuid())
  filename    String
  imageData   String
  capturedAt  DateTime @default(now())
  filter      String?
  frame       String?
  
  @@map("photo_sessions")
}